<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime. Licenses: MailKit/MimeKit MIT, HtmlSanitizer MIT, StackExchange.Redis MIT, Microsoft.* MIT. -->
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="MimeKit" Version="4.18.1" />
    <!-- Transitive via MimeKit: pinned to the patched version (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx; DoS). Remove once MimeKit requires >= 10.0.13. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.35" />
    <!-- Metrics export (VIN-035). OpenTelemetry Apache-2.0; the Prometheus exporter is still published as a pre-release. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15" />
    <!-- Tests. xunit.v3 Apache-2.0, Testcontainers MIT, coverlet MIT. -->
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
  </ItemGroup>
</Project>
