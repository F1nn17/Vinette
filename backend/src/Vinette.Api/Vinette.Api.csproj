<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Vinette.Api</AssemblyName>
    <RootNamespace>Vinette.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vinette.Core\Vinette.Core.csproj" />
    <ProjectReference Include="..\Vinette.Mail\Vinette.Mail.csproj" />
  </ItemGroup>
  <!-- `make api-types` builds with -p:GenerateOpenApi=true to emit the OpenAPI document at build time. -->
  <PropertyGroup>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GenerateOpenApi)' == 'true'">
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Vinette.Api.Tests" />
  </ItemGroup>
</Project>
