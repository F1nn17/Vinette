  "components": {
    "schemas": {
      "AddressDto": {
        "required": [
          "name",
          "address"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "AttachmentDto": {
        "required": [
          "partId",
          "fileName",
          "contentType",
          "size",
          "isMessage"
        ],
        "type": "object",
        "properties": {
          "partId": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "isMessage": {
            "type": "boolean"
          }
        }
      },
      "CsrfResponse": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "FolderDto": {
        "required": [
          "path",
          "name",
          "parentPath",
          "role",
          "canContainMessages",
          "total",
          "unread",
          "subscribed"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parentPath": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "type": "string"
          },
          "canContainMessages": {
            "type": "boolean"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "unread": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "subscribed": {
            "type": "boolean"
          }
        }
      },
      "FoldersResponse": {
        "required": [
          "folders"
        ],
        "type": "object",
        "properties": {
          "folders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FolderDto"
            }
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status",
          "version"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "LoginRequestBody": {
        "required": [
          "address",
          "password"
        ],
        "type": "object",
        "properties": {
          "address": {
            "maxLength": 254,
            "minLength": 0,
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 0,
            "type": "string"
          },
          "rememberMe": {
            "type": "boolean"
          }
        }
      },
      "LoginResponse": {
        "required": [
          "address"
        ],
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "address"
        ],
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          }
        }
      },
      "MessageDetailDto": {
        "required": [
          "id",
          "subject",
          "from",
          "to",
          "cc",
          "date",
          "seen",
          "flagged",
          "answered",
          "draft",
          "labels",
          "bodyFormat",
          "body",
          "blockedExternalResources",
          "truncated",
          "sender",
          "attachments"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "from": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AddressDto"
              }
            ]
          },
          "to": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddressDto"
            }
          },
          "cc": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddressDto"
            }
          },
          "date": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "seen": {
            "type": "boolean"
          },
          "flagged": {
            "type": "boolean"
          },
          "answered": {
            "type": "boolean"
          },
          "draft": {
            "type": "boolean"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bodyFormat": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "blockedExternalResources": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "truncated": {
            "type": "boolean"
          },
          "sender": {
            "$ref": "#/components/schemas/SenderDto"
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttachmentDto"
            }
          }
        }
      },
      "MessageListItemDto": {
        "required": [
          "id",
          "from",
          "to",
          "subject",
          "date",
          "seen",
          "flagged",
          "answered",
          "draft",
          "hasAttachments",
          "labels",
          "size",
          "preview"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AddressDto"
              }
            ]
          },
          "to": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddressDto"
            }
          },
          "subject": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "seen": {
            "type": "boolean"
          },
          "flagged": {
            "type": "boolean"
          },
          "answered": {
            "type": "boolean"
          },
          "draft": {
            "type": "boolean"
          },
          "hasAttachments": {
            "type": "boolean"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "size": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "preview": {
            "type": "string"
          }
        }
      },
      "MessageListResponse": {
        "required": [
          "items",
          "next",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageListItemDto"
            }
          },
          "next": {
            "type": [
              "null",
              "string"
            ]
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "QuotaResponse": {
        "required": [
