# Extra Dovecot settings for the Vinette dev mail server (appended by docker-mailserver).
# METADATA (RFC 5464) needs an attribute dictionary; without it the capability is not advertised.
mail_attribute_dict = file:%h/dovecot-attributes
# Dev only: allow plain-text login on the unencrypted port so the app can connect with Security=None.
disable_plaintext_auth = no
